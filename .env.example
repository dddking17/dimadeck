# Vercel Storage 에서 Neon 을 연결하면 자동 설정됩니다 (로컬 개발 시 직접 복사)
DATABASE_URL=

# Vercel Storage 에서 Blob 을 만들면 자동 설정됩니다 (이미지 업로드용, 선택)
BLOB_READ_WRITE_TOKEN=

# Auth.js — `npx auth secret` 또는 임의의 긴 문자열
AUTH_SECRET=
# Google Cloud → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 관리자 구글 이메일 (쉼표로 여러 개 가능). 덱/디지몬 카탈로그를 수정할 수 있는 계정
ADMIN_EMAIL=
