# ── Vercel 환경변수 (Settings → Environment Variables) ─────────────────
# 아래 중 DB / Blob 은 Vercel Storage 에서 Neon / Blob 을 연결하면 자동으로 들어옵니다.
# 직접 넣어야 하는 것은 AUTH_* 와 ADMIN_EMAIL 4개뿐입니다. (값에 따옴표·공백을 넣지 마세요)

# DB: Neon 연동이 POSTGRES_URL 이름으로 자동 등록 (DATABASE_URL 을 직접 넣으면 그쪽이 우선)
POSTGRES_URL=

# 이미지 업로드(관리자용, 선택): Blob 연동이 자동 등록
BLOB_READ_WRITE_TOKEN=

# 로그인 세션 암호화 키: 아무 긴 임의 문자열 (16자 이상)
AUTH_SECRET=
# Google Cloud → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)의 ID / 보안 비밀번호
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 관리자 구글 이메일 (쉼표로 여러 개 가능). 덱/디지몬 카탈로그를 수정할 수 있는 계정
ADMIN_EMAIL=
